# Environment Configuration for Docker Compose (Practical 11)
# Copy this file to .env in repository root to override defaults.

# -------------------------------------------------------------
# MongoDB Connection String:
# Default (containerized MongoDB service):
# MONGO_URI=mongodb://mongodb:27017/taskdb
#
# To connect to MongoDB Atlas instead, uncomment and supply credentials:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskdb?retryWrites=true&w=majority
# -------------------------------------------------------------

# Backend Server Port
PORT=5000

# JSON Web Token Secret (replace with your secure secret in production)
JWT_SECRET=supersecretjwtkey_practical11_change_in_production
JWT_EXPIRES_IN=1d

# Caching Configuration (Practical 8)
CACHE_ENABLED=true

# Background Notification Delay in Milliseconds (Practical 10)
NOTIFICATION_DELAY_MS=2000
